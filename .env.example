# Copy to .env. Paths are on the Docker host.
MEDIA_DIR=./media

MACOS9_DISK=macos9.qcow2
MACOS9_CDROM=macos-922-uni.iso
# c = hard disk, d = CD (installer / System Restore)
MACOS9_BOOT=c
MACOS9_MEM=512
MACOS9_CPU=7400_v2.9
MACOS9_MACHINE=mac99,via=pmu
DISPLAY_RES=1024x768x32

MACOS921_DISK=macos921.qcow2
MACOS921_BOOT=c

MACOS91_DISK=macos91.qcow2
MACOS91_BOOT=c

MACOS904_DISK=macos904.qcow2
MACOS904_CDROM=macos904.toast
# First boot installs from the 9.0.4 toast onto an empty qcow2.
MACOS904_BOOT=d
MACOS904_MACHINE=mac99
MACOS904_MEM=256

MACOS76_DISK=macos76.qcow2
MACOS76_CDROM=macos76.iso
MACOS76_ROM=800.ROM
MACOS76_BOOT=c

MACOS75_DISK=macos75.qcow2
MACOS75_CDROM=macos75.iso
MACOS75_ROM=800.ROM
MACOS75_BOOT=c

HAIKU_DISK=haiku-r1beta6-x86_64.qcow2
HAIKU_CDROM=
HAIKU_MEM=2048
HAIKU_SMP=2

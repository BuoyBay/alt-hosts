# Copy to .env. Paths are on the Docker host.
MEDIA_DIR=./media

MACOS9_DISK=macos9.qcow2
MACOS9_CDROM=macos-922-uni.iso
# c = hard disk, d = CD (installer / System Restore)
MACOS9_BOOT=c
MACOS9_MEM=512
MACOS9_CPU=7400_v2.9
MACOS9_MACHINE=mac99,via=pmu
DISPLAY_RES=1024x768x32

